#!/bin/bash
# ==============================================================================
# AGENTS-OS v5.0 — PRE-COMMIT SECURITY HOOK
# Zapobiega wyciekom tokenów API i plików konfiguracyjnych do repozytorium.
# Instalacja: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# ==============================================================================

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ERRORS=0

echo "🔐 [pre-commit] Uruchamianie skanera bezpieczeństwa AGENTS-OS..."

# --------------------------------------------------------------------------- #
# 1. Blokada plików .env w indeksie Git
# --------------------------------------------------------------------------- #
ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.|$)' || true)
if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}❌ BLOKADA: Próba dodania pliku .env do commita!${NC}"
    echo "   Plik(i): $ENV_FILES"
    echo "   Dodaj '.env' do .gitignore i usuń plik z indeksu:"
    echo "   git rm --cached <plik.env>"
    ERRORS=$((ERRORS + 1))
fi

# --------------------------------------------------------------------------- #
# 2. Skanowanie wycieków tokenów API
# --------------------------------------------------------------------------- #

# Wzorce tokenów do zablokowania
declare -a PATTERNS=(
    "gho_[A-Za-z0-9_]{36,}"                          # GitHub OAuth token
    "github_pat_[A-Za-z0-9_]{22,}"                   # GitHub PAT (fine-grained)
    "ghp_[A-Za-z0-9_]{36,}"                          # GitHub PAT (classic)
    "ghs_[A-Za-z0-9_]{36,}"                          # GitHub Server token
    "AIza[0-9A-Za-z\\-_]{35}"                        # Google/Gemini API key
    "sk-ant-api[0-9A-Za-z\\-_]{40,}"                 # Anthropic API key
    "sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20}"     # OpenAI API key (classic)
    "AKIA[0-9A-Z]{16}"                               # AWS Access Key ID
)

declare -a PATTERN_NAMES=(
    "GitHub OAuth Token (gho_)"
    "GitHub Fine-grained PAT (github_pat_)"
    "GitHub Classic PAT (ghp_)"
    "GitHub Server Token (ghs_)"
    "Google/Gemini API Key (AIza)"
    "Anthropic API Key (sk-ant-api)"
    "OpenAI API Key (sk-...T3BlbkFJ)"
    "AWS Access Key ID (AKIA)"
)

# Pliki staged do commita
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
    for i in "${!PATTERNS[@]}"; do
        PATTERN="${PATTERNS[$i]}"
        NAME="${PATTERN_NAMES[$i]}"

        # Sprawdź diff staged pod kątem wzorca (tylko dodane linie +)
        MATCHES=$(git diff --cached -U0 2>/dev/null | grep '^+' | grep -v '^+++' | grep -oE "$PATTERN" | head -5 || true)

        if [ -n "$MATCHES" ]; then
            echo -e "${RED}❌ WYCIEK TOKENU: Wykryto wzorzec '$NAME' w staged changes!${NC}"
            # Pokaż zamazany token (pierwsze 8 znaków + ***)
            echo "$MATCHES" | while IFS= read -r match; do
                MASKED="${match:0:8}***REDACTED***"
                echo "   Wykryto: $MASKED"
            done
            ERRORS=$((ERRORS + 1))
        fi
    done
fi

# --------------------------------------------------------------------------- #
# 3. Blokada plików konfiguracyjnych z potencjalnymi sekretami
# --------------------------------------------------------------------------- #
SENSITIVE_PATTERNS=(
    "\.env\."
    "credentials\.json$"
    "secrets\.ya?ml$"
    "\.pem$"
    "\.key$"
    "id_rsa$"
    "id_ed25519$"
)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    MATCHES=$(git diff --cached --name-only | grep -E "$pattern" || true)
    if [ -n "$MATCHES" ]; then
        echo -e "${YELLOW}⚠️  OSTRZEŻENIE: Potencjalnie wrażliwy plik w commicie: $MATCHES${NC}"
        echo "   Upewnij się, że plik nie zawiera sekretów."
        # Ostrzeżenie, nie blokada — pozostawia decyzję deweloperowi
    fi
done

# --------------------------------------------------------------------------- #
# Wynik
# --------------------------------------------------------------------------- #
if [ "$ERRORS" -gt 0 ]; then
    echo ""
    echo -e "${RED}🚫 COMMIT ZABLOKOWANY: Wykryto $ERRORS problem(y) bezpieczeństwa.${NC}"
    echo "   Napraw powyższe błędy i spróbuj ponownie."
    echo "   Aby ominąć (NIEBEZPIECZNE!): git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ [pre-commit] Skan zakończony — brak wycieków. Commit dozwolony.${NC}"
exit 0
