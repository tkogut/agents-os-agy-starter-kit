#!/bin/bash
# ==============================================================================
# os-init <project-name>
# AGENTS-OS v5.0 SWARM — Project Initializer
# Creates project, GitHub repo, commit+push, opens IDE.
# ==============================================================================

set -e

SKILL_SCRIPT="$HOME/.antigravity/skills/swarm-bootstrapper/scripts/bootstrap.py"

# Fallback: use local copy if not installed globally
if [ ! -f "$SKILL_SCRIPT" ]; then
    SKILL_SCRIPT="$(dirname "$(realpath "$0")")/global_skills/swarm-bootstrapper/scripts/bootstrap.py"
fi

if [ ! -f "$SKILL_SCRIPT" ]; then
    echo "❌ ERR: bootstrap.py not found. Run INSTALL.sh first."
    exit 1
fi

# --------------------------------------------------------------------------- #
# 1. Run bootstrapper and capture output
# --------------------------------------------------------------------------- #
echo "🚀 os-init: Running bootstrapper..."
PYTHON_BIN="python3"
if [ -f "$HOME/.antigravity/venv/bin/python" ]; then
    PYTHON_BIN="$HOME/.antigravity/venv/bin/python"
fi
OUTPUT=$("$PYTHON_BIN" "$SKILL_SCRIPT" "$@" 2>&1)

# Display output (excluding last line with path)
echo "$OUTPUT" | grep -v "^__PROJECT_DIR__:" || true

# --------------------------------------------------------------------------- #
# 2. Extract project path
# --------------------------------------------------------------------------- #
PROJECT_DIR=$(echo "$OUTPUT" | grep "^__PROJECT_DIR__:" | sed 's/^__PROJECT_DIR__://')

if [ -z "$PROJECT_DIR" ]; then
    echo "⚠️  Could not detect project path. Check bootstrap.py."
    exit 1
fi

echo ""
echo "📁 Project ready at: $PROJECT_DIR"

# --------------------------------------------------------------------------- #
# 2b. Dynamic generation of .gemini/mcp_config.json for the project
# --------------------------------------------------------------------------- #
MCP_CONFIG_DIR="$PROJECT_DIR/.gemini"
MCP_CONFIG_FILE="$MCP_CONFIG_DIR/mcp_config.json"
MCP_SERVER_PATH="$PROJECT_DIR/.agents/mcp-servers/antigravity-docs/mcp_server.js"

if [ -f "$MCP_SERVER_PATH" ]; then
    echo "⚙️  Generating dynamic mcp_config.json..."
    mkdir -p "$MCP_CONFIG_DIR"
    cat > "$MCP_CONFIG_FILE" <<EOF
{
  "mcpServers": {
    "antigravity-docs": {
      "command": "node",
      "args": [
        "${MCP_SERVER_PATH}"
      ],
      "description": "Antigravity IDE documentation knowledge base — search_docs, read_doc, list_document_names"
    }
  }
}
EOF
    echo "   ✅ mcp_config.json generated for: $PROJECT_DIR"
else
    echo "   ℹ️  MCP server not found — skipping mcp_config.json generation."
fi

# --------------------------------------------------------------------------- #
# 2c. Install pre-commit security hook in new project
# --------------------------------------------------------------------------- #
HOOK_SRC="$PROJECT_DIR/hooks/pre-commit"
HOOK_DST="$PROJECT_DIR/.git/hooks/pre-commit"
if [ -f "$HOOK_SRC" ] && [ -d "$PROJECT_DIR/.git/hooks" ]; then
    cp "$HOOK_SRC" "$HOOK_DST"
    chmod +x "$HOOK_DST"
    echo "🔐 Pre-commit security hook installed in project."
fi

# --------------------------------------------------------------------------- #
# 3. Open Antigravity IDE in WSL:Ubuntu environment
# --------------------------------------------------------------------------- #
# We use bin/antigravity-ide with --remote wsl+Ubuntu and a Linux path.
# Same as the antigravity() function in ~/.bashrc.d/antigravity.
# Do NOT use .exe or wslpath — --remote handles path mapping.

IDE_BIN=""
for user_dir in /mnt/c/Users/*; do
    if [ -f "${user_dir}/AppData/Local/Programs/Antigravity IDE/bin/antigravity-ide" ]; then
        IDE_BIN="${user_dir}/AppData/Local/Programs/Antigravity IDE/bin/antigravity-ide"
        break
    fi
done

if [ -z "$IDE_BIN" ]; then
    WIN_USER=$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r')
    if [ -n "$WIN_USER" ]; then
        IDE_BIN="/mnt/c/Users/${WIN_USER}/AppData/Local/Programs/Antigravity IDE/bin/antigravity-ide"
    fi
    # NOTE: No fallback to a hardcoded username — IDE will be skipped gracefully below.
fi

if [ "${OS_INIT_TEST:-false}" = "true" ]; then
    echo "🧪 [TEST] Skipping Antigravity IDE launch in test mode."
else
    echo "🖥️  Opening Antigravity IDE (WSL:Ubuntu) at: $PROJECT_DIR"
    if [ -f "$IDE_BIN" ]; then
        "$IDE_BIN" --remote wsl+Ubuntu "$PROJECT_DIR" &
        echo "   ✅ IDE launched in WSL:Ubuntu environment."
    elif command -v antigravity-ide &>/dev/null; then
        # Fallback: alias from .bashrc.d
        antigravity-ide --remote wsl+Ubuntu "$PROJECT_DIR" &
        echo "   ✅ IDE launched (via antigravity-ide alias)."
    else
        echo "   ℹ️  IDE not found. Open manually:"
        echo "   \"$IDE_BIN\" --remote wsl+Ubuntu \"$PROJECT_DIR\""
    fi
fi

# Detect GitHub user for display
GH_USER="your-github-username"
if command -v gh &>/dev/null; then
    GH_USER=$(gh api user -q .login 2>/dev/null || echo "your-github-username")
fi
if [ "$GH_USER" = "your-github-username" ]; then
    GH_USER=$(git config github.user 2>/dev/null || git config user.name 2>/dev/null | tr -d ' ' || echo "your-github-username")
fi

PROJECT_NAME=$(basename "$PROJECT_DIR")
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ PROJECT READY: $PROJECT_DIR"
echo "  🐙 GitHub: https://github.com/${GH_USER}/${PROJECT_NAME}"
echo ""
echo "  To navigate to the project in terminal:"
echo "  cd \"$PROJECT_DIR\""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Export path so the shell wrapper can cd into the project
export OS_INIT_PROJECT_DIR="$PROJECT_DIR"
